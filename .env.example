# Todoist personal API token — get it from https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# GitHub username (used for public profile stats, no token needed)
GITHUB_USERNAME=DruidaMarreco

# URL where hey-claude-web is running (default: http://localhost:8000)
HEYCLAUDE_URL=http://localhost:8000

# Weather location for context (defaults to Lisbon) — find your coordinates at maps.google.com
WEATHER_LAT=38.71
WEATHER_LON=-9.14

# Ollama local AI (https://ollama.com) — set URL to enable the Ollama provider.
# Install: winget install Ollama.Ollama  then: ollama pull llama3.2
# Leave blank to disable; JARVIS works fine without it.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
